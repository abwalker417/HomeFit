# --- Garage BuiltHere kiosk: GeeekPi EP-0189 (11.26", 1920x440) --------------
# Append to /boot/firmware/config.txt
#
# RESOLUTION is NOT hard-coded here on purpose: read the panel's real timing
# from its EDID first (README step 2A). If EDID auto-detect fails, build the
# hdmi_timings line from the edid-decode output (step 2B) and add it here with
# hdmi_group=2 / hdmi_mode=87 / hdmi_force_mode=1. Do not paste another panel's
# timing — the porches/clock are panel-specific.

# --- kiosk bits (always apply) ---
# Drive the panel even if it handshakes slowly / is powered after the Pi
hdmi_force_hotplug=1
# No black borders around the custom resolution
disable_overscan=1
# Never blank the console behind the kiosk
# (also add `consoleblank=0` to the end of /boot/firmware/cmdline.txt)
