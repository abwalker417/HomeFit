# --- Garage HomeFit kiosk: GeeekPi EP-0189 (1920x480) ----------------------
# Append to /boot/firmware/config.txt
#
# PREFER the GeeekPi resolution tool (README step 2A); it writes the right
# timing + rotation for you. The hdmi_* block below is the MANUAL FALLBACK
# (community-proven for the HSD088IPW1 panel). If you used the tool, do NOT
# also paste the hdmi_timings block — just keep the kiosk bits at the bottom.

# --- panel timing (MANUAL fallback only) ---
# Native panel is 480x1920 portrait, rotated to 1920x480 landscape.
hdmi_timings=480 1 48 32 80 1920 0 3 10 56 0 0 0 60 0 75840000 3
hdmi_group=2
hdmi_mode=87
hdmi_force_mode=1
hdmi_drive=1
config_hdmi_boost=4
max_framebuffer_height=1920
display_hdmi_rotate=1
# If text is upside down, use display_hdmi_rotate=3 instead.

# --- kiosk bits (always apply) ---
# Drive the panel even if it handshakes slowly / is powered after the Pi
hdmi_force_hotplug=1
# No black borders around the custom resolution
disable_overscan=1
# Never blank the console behind the kiosk
# (also add `consoleblank=0` to the end of /boot/firmware/cmdline.txt)
